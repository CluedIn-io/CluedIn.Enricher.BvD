<Project>
  <PropertyGroup Label="Dependency Versions">
    <_AutoFixtureV3>5.0.0-preview0012</_AutoFixtureV3>
    <_AutoFixtureV2>4.18.0</_AutoFixtureV2>
    <!-- Guarded so the pipeline's -p:_CluedIn=<version> per build leg wins; Directory.Build.props
         sets the same default/guard earlier for DefineConstants derivation. -->
    <_CluedIn Condition="'$(_CluedIn)' == ''">5.0.0-*</_CluedIn>
    <_CluedInPackageSuffix>$(_CluedInVersionOnly.Replace('.', ''))</_CluedInPackageSuffix>
  </PropertyGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies in test projects

        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="coverlet.msbuild" Version="2.8.0" />
    <PackageReference Update="Moq" Version="4.13.1" />
    <PackageReference Update="Shouldly" Version="3.0.2" />
  </ItemGroup>
  <!-- xunit v3 + AutoFixture.Xunit3 for net10.0 (CluedIn 5.0+) -->
  <ItemGroup Condition="$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Update="xunit.v3" Version="3.2.2" />
    <PackageReference Update="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Update="AutoFixture.Xunit3" Version="$(_AutoFixtureV3)" />
  </ItemGroup>
  <!-- xunit v2 + AutoFixture.Xunit2 for net6.0 (CluedIn < 5.0) -->
  <ItemGroup Condition="!$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Update="xunit" Version="2.9.3" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Update="AutoFixture.Xunit2" Version="$(_AutoFixtureV2)" />
  </ItemGroup>
  <!-- CluedIn.Testing.Base publishes a differently-suffixed package ID per CluedIn generation
       (.470/.480/.500 - the Integration.Tests csproj's own Include must use the same interpolated
       ID, not a static "CluedIn.Testing.Base"). -->
  <ItemGroup>
    <PackageReference Update="CluedIn.Testing.Base.$(_CluedInPackageSuffix)" Version="1.0.0-*" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies across the solution

        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="CluedIn.Core" Version="$(_CluedIn)" />
    <PackageReference Update="CluedIn.ExternalSearch" Version="$(_CluedIn)" />
    <PackageReference Update="CluedIn.Integration.PrivateServices" Version="$(_CluedIn)" />
  </ItemGroup>
</Project>
